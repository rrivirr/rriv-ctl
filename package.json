{
  "name": "rriv-cli",
  "version": "2.18.0-preview-share.2",
  "description": "rriv cross-platform cli client",
  "bin": "./dist/index.cjs",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@sentry/rollup-plugin": "^5.1.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.30.1",
    "husky": "^9.1.7",
    "rollup": "^4.50.2",
    "rollup-plugin-preserve-shebangs": "^0.2.0",
    "semantic-release-export-data": "^1.1.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "start": "tsx ./src/index.ts",
    "build": "rm -rf ./dist && rollup --config",
    "lint": "eslint ./src ./tests",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepare": "husky",
    "binary": "npm run build && rm -rf ./apps && pkg ."
  },
  "pkg": {
    "assets": [
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*",
      "src/modules/firmware/scripts/*",
      "src/modules/update/util/update.sh"
    ],
    "outputPath": "./apps",
    "targets": [
      "node22-linux-x64",
      "node22-macos-x64",
      "node22-linux-arm64",
      "node22-macos-arm64"
    ]
  },
  "author": "",
  "license": "GPLV3",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@inquirer/prompts": "^7.3.1",
    "@octokit/rest": "^22.0.0",
    "@sentry/node": "^10.46.0",
    "@types/omelette": "^0.4.5",
    "@yao-pkg/pkg": "^6.6.0",
    "axios": "^1.11.0",
    "cli-table3": "^0.6.5",
    "commander": "^9.4.0",
    "dotenv": "^17.2.1",
    "jwt-decode": "^4.0.0",
    "lowdb": "^7.0.1",
    "moment": "^2.30.1",
    "mqtt": "^5.14.1",
    "omelette": "^0.4.17",
    "ora": "^9.4.0",
    "serialport": "^13.0.0",
    "yoctocolors": "^2.1.1"
  }
}

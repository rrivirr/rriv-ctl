{
  "name": "rriv-cli",
  "version": "1.1.0-alpha.27",
  "description": "rriv cross-platform cli client",
  "bin": "./dist/index.cjs",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/figlet": "^1.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.30.1",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "rollup": "^4.50.2",
    "semantic-release-export-data": "^1.1.1",
    "ts-jest": "^29.4.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "scripts": {
    "start": "tsx ./src/index.ts",
    "build": "rm -rf ./dist && rollup --config",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "binary": "npm run build && rm -rf ./apps && pkg ."
  },
  "pkg": {
    "assets": [
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*",
      "rrivctl-installer.sh",
      "src/modules/firmware/scripts/*"
    ],
    "outputPath": "./apps",
    "targets": [
      "node22-linux-x64",
      "node22-macos-x64",
      "node22-win-x64",
      "node22-linux-arm64",
      "node22-macos-arm64",
      "node22-win-arm64"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^7.3.1",
    "@octokit/rest": "^22.0.0",
    "@yao-pkg/pkg": "^6.6.0",
    "axios": "^1.11.0",
    "cli-table3": "^0.6.5",
    "commander": "^9.4.0",
    "dotenv": "^17.2.1",
    "figlet": "^1.8.2",
    "jwt-decode": "^4.0.0",
    "lowdb": "^7.0.1",
    "moment": "^2.30.1",
    "serialport": "^13.0.0",
    "yoctocolors": "^2.1.1"
  }
}
